---
import { ClientRouter } from 'astro:transitions';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import '../styles/main.scss';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  hideFooter?: boolean;
}

const lang = (Astro.currentLocale || 'es') as Lang;
const t = useTranslations(lang);

const {
  title,
  description = t('seo.description'),
  image = '/Logo_Agrovalue.png',
  keywords = 'agroexportación, agricultura, comercialización agrícola, inversión agrícola, trazabilidad, fruta fresca, logística internacional, Agrovalue',
  hideFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://agrovalue.org');
const imageUrl = new URL(image, canonicalURL);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name="theme-color" content="#1a422a">
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' href='/Logo_AgrovalueV.ico' />
    <meta name='generator' content={Astro.generator} />
    <link rel='icon' href='/Logo_Agrovalue192.png' type='image/png' sizes='192x192' />
    <link rel='apple-touch-icon' href='/apple-icon.png' />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content='Cristian Braco' />
    <meta name='keywords' content={keywords} />
    <meta name='robots' content='index, follow' />
    <link rel='canonical' href={canonicalURL} />

    <!-- SEO Internacional: Enrutamiento de Idiomas para Google -->
    <link rel="alternate" hreflang="es" href={new URL(canonicalURL.pathname.replace(/^\/en/, ''), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en' + canonicalURL.pathname.replace(/^\/en/, ''), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(canonicalURL.pathname.replace(/^\/en/, ''), Astro.site)} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={imageUrl} />
    <meta property='og:site_name' content='Agrovalue' />
    <meta property='og:locale' content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta property='twitter:card' content='summary_large_image' />
    <meta property='twitter:url' content={canonicalURL} />
    <meta property='twitter:title' content={title} />
    <meta property='twitter:description' content={description} />
    <meta property='twitter:image' content={imageUrl} />

    <!-- Fuentes Google -->
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link href='https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap' rel='stylesheet' />

    <!-- JSON-LD SEO -->
    <script type='application/ld+json' set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Agrovalue",
      "url": "https://www.agrovalue.org",
      "logo": "https://www.agrovalue.org/Logo_Agrovalue.png",
      "description": description,
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "comercial@agrovalue.org",
        "contactType": "customer support",
        "availableLanguage": ["es", "en"]
      },
      "sameAs": ["https://www.linkedin.com/company/agrovalue-org"]
    })} />
    <ClientRouter/>
  </head>
  <body>
    <div class='app-container'>
      <Header />
      <main class='main-content'>
        <slot />
      </main>
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>