---
import { Image } from 'astro:assets';
import { ArrowRight, ChevronUp } from '@lucide/astro';

import { perfilesData } from '../data/serviciosData.js';
import { useTranslations, type Lang } from '../i18n/utils';
import { hashes } from '../i18n/ui';

import bannerMobile from '../assets/servicios/banner_Service_Desktop.webp';
import bannerTablet from '../assets/servicios/banner_Service_Desktop.webp';
import bannerDesktop from '../assets/servicios/banner_Service_Desktop.webp';
import logoBlanco from '../assets/Logo_Agrovalue_blanco.svg';

const lang = (Astro.currentLocale || 'es') as Lang;
const t = useTranslations(lang);
const h = hashes[lang];

// Extraemos la data dinámicamente según el idioma actual
const currentData = perfilesData[lang];
const titleWords = t('services.hero.title').split(' ');
---

<section class='hero-servicios'>
  <div class='hero-servicios__background'>
    <Image src={bannerMobile} alt='Fondo Servicios Mobile' class='hero-servicios__image hero-servicios__image--mobile' loading='eager' />
    <Image src={bannerTablet} alt='Fondo Servicios Tablet' class='hero-servicios__image hero-servicios__image--tablet' loading='eager' />
    <Image src={bannerDesktop} alt='Fondo Servicios Desktop' class='hero-servicios__image hero-servicios__image--desktop' loading='eager' />
    <div class='hero-servicios__overlay'></div>
  </div>

  <div class='hero-servicios__content'>
    <span class='hero-servicios__subtitle text-reveal'>{t('services.hero.subtitle')}</span>
    <h1 class='hero-servicios__title'>
      {titleWords.map((word) => (
        <span class='word-wrap'><span class='word'>{word}</span>&nbsp;</span>
      ))}
    </h1>

    <div class='hero-servicios__actions text-reveal'>
      <a href={h.h1} class='btn-profile'>
        <span>{t('services.hero.btn1')}</span>
        <ArrowRight size={20} />
      </a>
      <a href={h.h2} class='btn-profile'>
        <span>{t('services.hero.btn2')}</span>
        <ArrowRight size={20} />
      </a>
      <a href={h.h3} class='btn-profile'>
        <span>{t('services.hero.btn3')}</span>
        <ArrowRight size={20} />
      </a>
    </div>
  </div>
</section>

<section class='perfiles-wrapper'>
  {currentData.map((perfil) => (
    <section class='perfil-detail' id={perfil.id}>
      <div class='pd-intro'>
        <div class='pd-intro-content'>
          <div class='pd-intro-content-container1'>
            <span class='pd-intro-content-container1__number'>{perfil.number}</span>
          </div>
          <div class='pd-intro-content-container2'>
            <span class='pd-intro-content-container2__subtitle'>{perfil.subtitle}</span>
            <h2 class='pd-intro-content-container2__title'>{perfil.title}</h2>
            <p class='pd-intro-content-container2__text'>{perfil.text}</p>
          </div>
        </div>
      </div>

      <div class='pd-comparison'>
        <div class='pd-comparison-container'>
          <div class='pd-comparison-container__box pd-comparison-container__box--dark'>
            <span class='pd-comparison-container__subtitle'>{perfil.problem.subtitle}</span>
            <h3 class='pd-comparison-container__title'>{perfil.problem.title}</h3>
            <p class='pd-comparison-container__text'>{perfil.problem.text}</p>
          </div>

          <div class='pd-comparison-container__box pd-comparison-container__box--light'>
            <span class='pd-comparison-container__subtitle'>{perfil.solution.subtitle}</span>
            <h3 class='pd-comparison-container__title'>{perfil.solution.title}</h3>
            <p class='pd-comparison-container__text'>{perfil.solution.text}</p>
          </div>

          <div class='pd-comparison-container__icon'>
            <Image src={logoBlanco} alt='Logo Agrovalue' width={24} height={24} />
          </div>
        </div>
      </div>

      <div class='pd-image'>
        <Image src={perfil.image} alt={perfil.imageAlt} class='pd-image__img' />
      </div>

      {/* RENDERIZADO CONDICIONAL: Si es una lista normal (Sección 1 y 2) */}
      {!perfil.serviceGroups && perfil.services && perfil.services.length > 0 && (
        <div class='pd-services'>
          <div class='pd-content'>
            <span class='pd-section-subtitle'>{t('services.section.whatwedo')}</span>
            <div class='pd-list'>
              {perfil.services.map((service) => (
                <div class='pd-list__item'>
                  <span class='pd-list__num'>{service.num}</span>
                  <div class='pd-list__content'>
                    <h4>{service.title}</h4>
                    <p>{service.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* RENDERIZADO CONDICIONAL: Si está dividido por grupos (Sección 3) */}
      {perfil.serviceGroups && perfil.serviceGroups.length > 0 && (
        <div class='pd-services'>
          <div class='pd-content'>
            {perfil.serviceGroups.map((group) => (
              <div class='pd-service-group'>
                <span class='pd-section-subtitle'>{t('services.section.whatwedo')}</span>
                <h3 class='pd-service-group__title'>{group.groupTitle}</h3>
                <div class='pd-list'>
                  {group.items.map((service) => (
                    <div class='pd-list__item'>
                      <span class='pd-list__num'>{service.num}</span>
                      <div class='pd-list__content'>
                        <h4>{service.title}</h4>
                        <p>{service.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {perfil.processes && perfil.processes.length > 0 && (
        <div class='pd-process'>
          <div class='pd-content'>
            <span class='pd-section-subtitle'>{t('services.section.howwework')}</span>
            <div class='pd-process-list'>
              {perfil.processes.map((process) => (
                <div class='pd-process-list__item'>
                  <div class='pd-process-list-content1'>
                    <div class='pd-process-list-content1__circle'>{process.num}</div>
                    <div class='pd-process-list-content1__line' />
                  </div>
                  <div class='pd-process-list-content2'>
                    <h4>{process.title}</h4>
                    <p>{process.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      <div class='pd-cta'>
        <div class='pd-content'>
          <div class='pd-cta-container'>
            <h3 class='pd-cta-container__title'>{perfil.cta.title}</h3>
            <p class='pd-cta-container__text'>{perfil.cta.text}</p>
          </div>
          <a href={perfil.cta.btnLink} class='pd-cta__btn'>
            {perfil.cta.btnText} <ArrowRight size={18} />
          </a>
        </div>

        <button class='pd-scroll-top' aria-label={t('services.btn.backtotop')}>
          <ChevronUp size={20} />
        </button>
      </div>
    </section>
  ))}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    
    let ctx = gsap.context(() => {
      
      // Scroll Suave en carga inicial con hash
      if (window.location.hash) {
        const target = document.querySelector(window.location.hash);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth' });
            window.history.replaceState({}, document.title, window.location.pathname);
          }, 100);
        }
      }

      // Botón "Volver Arriba"
      document.querySelectorAll('.pd-scroll-top').forEach((btn) => {
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      });

      // Scroll Suave botones Hero
      document.querySelectorAll('.btn-profile').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Animación Hero
      const tlHero = gsap.timeline();
      gsap.set('.hero-servicios__subtitle', { autoAlpha: 0, y: 20 });
      gsap.set('.hero-servicios .word', { y: '100%' });
      gsap.set('.hero-servicios__actions', { autoAlpha: 0, y: 20 });

      tlHero
        .to('.hero-servicios__subtitle', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.3 })
        .to('.hero-servicios .word', { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' }, '-=0.4')
        .to('.hero-servicios__actions', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.2');

      // Animación Perfiles
      const perfiles = document.querySelectorAll('.perfil-detail');
      perfiles.forEach((perfil) => {
        const introElements = perfil.querySelectorAll('.pd-intro-content-container1__number, .pd-intro-content-container2 > *');
        gsap.from(introElements, { scrollTrigger: { trigger: perfil.querySelector('.pd-intro'), start: 'top 85%' }, y: 40, autoAlpha: 0, duration: 0.8, stagger: 0.15, ease: 'power3.out' });

        const compBoxes = perfil.querySelectorAll('.pd-comparison-container__box');
        const compIcon = perfil.querySelector('.pd-comparison-container__icon');
        const tlComp = gsap.timeline({ scrollTrigger: { trigger: perfil.querySelector('.pd-comparison'), start: 'top 80%' } });
        tlComp
          .from(compBoxes, { y: 50, autoAlpha: 0, duration: 0.8, stagger: 0.2, ease: 'power3.out' })
          .from(compIcon, { scale: 0, autoAlpha: 0, duration: 0.6, ease: 'back.out(1.5)' }, '-=0.4');

        const image = perfil.querySelector('.pd-image__img');
        if (image) gsap.from(image, { scrollTrigger: { trigger: perfil.querySelector('.pd-image'), start: 'top 85%' }, y: 30, autoAlpha: 0, scale: 0.97, duration: 1, ease: 'power3.out' });

        ['.pd-services', '.pd-process', '.pd-cta'].forEach((selector) => {
          const section = perfil.querySelector(selector);
          if (section) {
            const items = section.querySelectorAll(selector === '.pd-cta' ? '.pd-cta-container__title, .pd-cta-container__text' : '.pd-section-subtitle, .pd-service-group__title, .pd-list__item, .pd-process-list__item');
            gsap.from(items, { scrollTrigger: { trigger: section, start: 'top 85%' }, y: 30, autoAlpha: 0, duration: 0.8, stagger: 0.15, ease: 'power3.out' });
          }
        });
      });

    });

    document.addEventListener('astro:before-preparation', () => {
      ctx.revert();
    }, { once: true });

  });
</script>