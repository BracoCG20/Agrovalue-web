---
/**
 * Componente: Footer
 * Descripción: Contiene la identidad de marca, navegación principal y enlaces a redes sociales.
 * Animaciones: GSAP ScrollTrigger activado al entrar en el viewport.
 */
const currentYear = new Date().getFullYear();

//  Forzamos el tipado para que TypeScript sepa que solo puede ser 'es' o 'en'
const lang = (Astro.currentLocale === 'en' ? 'en' : 'es') as 'es' | 'en';

//  MAPA DE RUTAS
const routeMap = {
  '/': '/',
  '/nosotros': '/about-us',
  '/servicios': '/services',
  '/contacto': '/contact',
};

// Rutas dinámicas inteligentes
const getRoute = (path: keyof typeof routeMap) => {
  if (lang === 'es') return path;

  const englishPath = routeMap[path];
  return `/en${englishPath === '/' ? '' : englishPath}`;
};

// Diccionario
const translations = {
  es: {
    desc: 'Creamos soluciones tecnológicas y sostenibles para hacer crecer el campo, poniendo siempre en el centro a quienes lo trabajan día a día.',
    navTitle: 'NAVEGACIÓN',
    socialTitle: 'SÍGUENOS',
    inicio: 'Inicio',
    nosotros: 'Nosotros',
    servicios: 'Servicios',
    contacto: 'Contacto',
    derechos: 'Todos los derechos reservados.',
  },
  en: {
    desc: 'We create sustainable technology solutions that drive agricultural growth while keeping the people who work the land every day at the center of what we do.',
    navTitle: 'NAVIGATION',
    socialTitle: 'FOLLOW US',
    inicio: 'Home',
    nosotros: 'About Us',
    servicios: 'Services',
    contacto: 'Contact Us',
    derechos: 'All rights reserved.',
  },
};

// Asignamos la traducción segura
const t = translations[lang];
---

<footer class='footer'>
  <div
    class='footer__container'
    id='contain-footer'
  >
    <div class='footer__brand'>
      <a
        href={getRoute('/')}
        class='footer__logo gs-reveal'
      >
        <div class='footer__logo-icon'>
          <img
            src='/Logo_AgrovalueHB.png'
            alt='Logo Agrovalue'
            height='50'
          />
        </div>
      </a>
      <p class='footer__description gs-reveal'>{t.desc}</p>
    </div>

    <div class='footer__links-wrapper'>
      <div class='footer__nav gs-reveal'>
        <h4 class='footer__title'>{t.navTitle}</h4>
        <ul class='footer__list'>
          <li><a href={getRoute('/')}>{t.inicio}</a></li>
          <li><a href={getRoute('/nosotros')}>{t.nosotros}</a></li>
          <li><a href={getRoute('/servicios')}>{t.servicios}</a></li>
          <li><a href={getRoute('/contacto')}>{t.contacto}</a></li>
        </ul>
      </div>

      <div class='footer__social gs-reveal'>
        <h4 class='footer__title'>{t.socialTitle}</h4>
        <ul class='footer__list'>
          <li>
            <a
              href='https://www.linkedin.com/company/agrovalue-org/'
              target='_blank'
              rel='noopener noreferrer'
              class='social-link'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='20'
                height='20'
                viewBox='0 0 24 24'
              >
                <path
                  d='M0 0h24v24H0z'
                  fill='none'
                ></path>
                <path
                  fill='currentColor'
                  d='M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z'
                ></path>
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class='footer__bottom gs-reveal-bottom'>
    <div class='footer__bottom-container'>
      <p>&copy; {currentYear} Agrovalue. {t.derechos}</p>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.getElementById('contain-footer');

    if (footer) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: footer,
          start: 'top 150%',
        },
      });

      tl.fromTo(
        '.gs-reveal',
        { y: 30, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.6,
          stagger: 0.15,
          ease: 'power3.out',
        },
      ).fromTo(
        '.gs-reveal-bottom',
        { y: 20, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.6, ease: 'power3.out' },
        '-=0.3',
      );
    }
  });
</script>
