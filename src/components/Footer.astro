---
/**
 * Componente Footer
 * Información de la marca, enlaces de navegación y redes sociales.
 */
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    
    <!-- Bloque de Marca y Descripción -->
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <div class="footer__logo-icon">
          <img src="/Logo_Agrovalue.svg" alt="Logo Agrovalue" />
        </div>
        <span class="footer__logo-text">Agrovalue</span>
      </a>
      <p class="footer__description">
        Creamos soluciones tecnológicas y sostenibles para hacer crecer el campo, poniendo siempre en el centro a quienes lo trabajan día a día.
      </p>
    </div>

    <!-- Bloque de Enlaces -->
    <div class="footer__links-wrapper">
      
      <!-- Navegación -->
      <div class="footer__nav">
        <h4 class="footer__title">NAVEGACIÓN</h4>
        <ul class="footer__list">
          <li><a href="/">Inicio</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>

      <!-- Redes Sociales -->
      <div class="footer__social">
        <h4 class="footer__title">SÍGUENOS</h4>
        <ul class="footer__list">
          <li>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
                <path d="M0 0h24v24H0z" fill="none" />
                <path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z" />
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Línea divisoria y Copyright -->
  <div class="footer__bottom">
    <div class="footer__bottom-container">
      <p>&copy; {currentYear} Agrovalue. Todos los derechos reservados.</p>
      <p>Industria agropecuaria & agroindustrial</p>
    </div>
  </div>
</footer>