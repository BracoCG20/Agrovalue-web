---
//src/components/Header.astro
/**
 * Componente: Header
 * Descripción: Navegación global del sitio. Soporta menú móvil interactivo
 * y barra de navegación transparente que aplica efecto blur al hacer scroll.
 */
import { Menu, X, ArrowRight } from '@lucide/astro';

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---

<header
  class='header'
  id='main-header'
>
  <div class='header__container'>
    <a
      href='/'
      class='header__logo'
    >
      <img
        src='/Logo_Agrovalue.svg'
        alt='Logo Agrovalue'
      />
      <span class='header__logo-text'>Agrovalue</span>
    </a>

    <!-- Navegación Desktop -->
    <nav class='header__nav-desktop'>
      <ul class='nav-list-desktop'>
        <li
          class={`nav-list-desktop__item ${isActive('/') ? 'is-active' : ''}`}
        >
          <a href='/'>Inicio</a>
        </li>
        <li
          class={`nav-list-desktop__item ${isActive('/nosotros') ? 'is-active' : ''}`}
        >
          <a href='/nosotros'>Nosotros</a>
        </li>
        <li
          class={`nav-list-desktop__item has-sub ${isActive('/servicios') ? 'is-active' : ''}`}
        >
          <a href='/servicios'>Servicios <span class='dropdown-icon'>▾</span></a
          >
          <ul class='sub-menu-desktop'>
            <li>
              <a href='/servicios#productores'>· Productores y exportadores</a>
            </li>
            <li>
              <a href='/servicios#importadores'
                >· Importadores y distribuidores</a
              >
            </li>
            <li><a href='/servicios#proyectos'>· Proyectos especiales</a></li>
          </ul>
        </li>
        <li
          class={`nav-list-desktop__item ${isActive('/contacto') ? 'is-active' : ''}`}
        >
          <a href='/contacto'>Contacto</a>
        </li>
      </ul>

      <div class='header__action-desktop'>
        <a
          href='/contacto'
          class='btn-glow'
          >Contáctanos</a
        >
      </div>
    </nav>

    <!-- Botón Toggle Menú Móvil -->
    <button
      class='header__toggle'
      id='menu-toggle'
      aria-label='Alternar menú'
      aria-expanded='false'
    >
      <Menu
        class='icon-menu'
        size={28}
      />
      <X
        class='icon-close'
        size={20}
      />
    </button>
  </div>

  <!-- Navegación Móvil -->
  <nav
    class='header__nav'
    id='main-nav'
  >
    <div class='header__nav-content'>
      <ul class='nav-list'>
        <li class={`nav-list__item ${isActive('/') ? 'is-active' : ''}`}>
          <a href='/'
            >Inicio <ArrowRight
              size={18}
              color='#86C46A'
            /></a
          >
        </li>
        <li
          class={`nav-list__item ${isActive('/nosotros') ? 'is-active' : ''}`}
        >
          <a href='/nosotros'
            >Nosotros <ArrowRight
              size={18}
              color='#86C46A'
            /></a
          >
        </li>
        <li
          class={`nav-list__item has-sub ${isActive('/servicios') ? 'is-active' : ''}`}
        >
          <a href='/servicios'
            >Servicios <ArrowRight
              size={18}
              color='#86C46A'
            /></a
          >
          <ul class='sub-menu'>
            <li>
              <a href='/servicios#productores'>· Productores y exportadores</a>
            </li>
            <li>
              <a href='/servicios#importadores'
                >· Importadores y distribuidores</a
              >
            </li>
            <li><a href='/servicios#proyectos'>· Proyectos especiales</a></li>
          </ul>
        </li>
        <li
          class={`nav-list__item ${isActive('/contacto') ? 'is-active' : ''}`}
        >
          <a href='/contacto'
            >Contacto <ArrowRight
              size={18}
              color='#86C46A'
            /></a
          >
        </li>
      </ul>

      <div class='header__action'>
        <a
          href='/contacto'
          class='btn-glow'
          >Contáctanos</a
        >
      </div>

      <div class='header__footer'>
        <a
          href='https://linkedin.com'
          target='_blank'
          rel='noopener noreferrer'
          class='social-btn'
          aria-label='LinkedIn'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
          >
            <path
              d='M0 0h24v24H0z'
              fill='none'
            ></path>
            <path
              fill='currentColor'
              d='M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z'
            ></path>
          </svg>
        </a>
        <span class='copyright'>&copy; {currentYear} Agrovalue</span>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Control de Header Fixed al Scroll
    const header = document.getElementById('main-header');

    const handleScroll = () => {
      if (!header) return;
      if (window.scrollY > 50) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // Animación de Menú Móvil con GSAP
    let mm = gsap.matchMedia();

    mm.add('(max-width: 1023px)', () => {
      const toggleBtn = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');
      const navItems = document.querySelectorAll('.nav-list__item');
      const actionBtn = document.querySelector('.header__action');
      const footer = document.querySelector('.header__footer');

      if (!header || !toggleBtn || !nav) return;

      const menuTl = gsap.timeline({ paused: true, reversed: true });

      menuTl
        .to(nav, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power3.inOut' })
        .fromTo(
          navItems,
          { y: 20, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.4,
            stagger: 0.05,
            ease: 'power3.out',
          },
          '-=0.2',
        )
        .fromTo(
          [actionBtn, footer],
          { y: 20, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.4, ease: 'power3.out' },
          '-=0.2',
        );

      const clickHandler = () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');

        header.classList.toggle('is-open');

        if (!isExpanded) {
          document.body.style.overflow = 'hidden';
          document.documentElement.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
        }

        menuTl.reversed() ? menuTl.play() : menuTl.reverse();
      };

      toggleBtn.addEventListener('click', clickHandler);

      return () => {
        toggleBtn.removeEventListener('click', clickHandler);
        header.classList.remove('is-open');
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
      };
    });
  });
</script>
