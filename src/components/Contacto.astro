---
import { Image } from 'astro:assets';
import { Mail } from '@lucide/astro';
import { useTranslations, type Lang } from '../i18n/utils';

import imgContacto from '../assets/contacto/contacto.webp';

const lang = (Astro.currentLocale || 'es') as Lang;
const t = useTranslations(lang);
---

<section class='hero-contacto'>
  <div class='hero-contacto__container'>
    <span class='hero-contacto__subtitle text-reveal'>{t('contact.hero.subtitle')}</span>
    <h1 class='hero-contacto__title text-reveal'>
      <span class='word-wrap'>{t('contact.hero.title')}</span>
    </h1>
    <p class='hero-contacto__description text-reveal'>
      {t('contact.hero.desc')}
    </p>
  </div>
</section>

<section class='contacto-content'>
  <div class='contacto-content__container'>
    <div class='contacto-content__col-info trigger-reveal-contact'>
      <div class='contact-card contact-card--info'>
        <h2 class='contact-card__title'>{t('contact.info.title')}</h2>
        <p class='contact-card__desc'>
          {t('contact.info.desc')}
        </p>

        <ul class='contact-list'>
          <li>
            <a href='mailto:comercial@agrovalue.org' class='contact-list__icon' aria-label='Enviar correo'>
              <Mail size={20} stroke-width={2} />
            </a>
            <div class='contact-list__text'>
              <span class='label'>{t('contact.info.email')}</span>
              <a href='mailto:comercial@agrovalue.org' class='value'>comercial@agrovalue.org</a>
            </div>
          </li>
          <li>
            <a href='https://www.linkedin.com/company/agrovalue-org/' target='_blank' rel='noopener noreferrer' class='contact-list__icon' aria-label='LinkedIn'>
              <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24'><path d='M0 0h24v24H0z' fill='none'></path><path fill='currentColor' d='M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z'></path></svg>
            </a>
            <div class='contact-list__text'>
              <span class='label'>{t('contact.info.linkedin')}</span>
              <a href='https://www.linkedin.com/company/agrovalue-org/' target='_blank' rel='noopener noreferrer' class='value'>/company/agrovalue</a>
            </div>
          </li>
        </ul>
      </div>

      <div class='contact-card contact-card--image'>
        <Image src={imgContacto} alt='Campo Agrovalue' class='contact-card__img' />
        <div class='contact-card__overlay'>
          <h3>{t('contact.image.overlay')}</h3>
        </div>
      </div>
    </div>

    <div class='contacto-content__col-form trigger-reveal-contact'>
      <div class='contact-card contact-card--form'>
        <form
          id='agrovalue-contact-form'
          class='contact-form'
          data-msg-sending={t('contact.form.msg.sending')}
          data-msg-success={t('contact.form.msg.success')}
          data-msg-error={t('contact.form.msg.error')}
        >
          <!-- Honeypot -->
          <div style='display:none; position:absolute; left:-9999px;' aria-hidden='true'>
            <label for='bot_field'>{t('contact.form.honeypot')}</label>
            <input type='text' id='bot_field' name='bot_field' tabindex='-1' autocomplete='off' />
            <input type='hidden' id='form_time' name='form_time' value='' />
          </div>

          <div class='form-group'>
            <span class='form-label'>{t('contact.form.iam')}</span>
            <div class='radio-pill-group'>
              <label class='radio-pill'>
                <input type='radio' name='perfil' value='productor/exportador' checked />
                <span class='pill-text'>{t('contact.form.profile1')}</span>
              </label>
              <label class='radio-pill'>
                <input type='radio' name='perfil' value='importador/distribuidor' />
                <span class='pill-text'>{t('contact.form.profile2')}</span>
              </label>
              <label class='radio-pill'>
                <input type='radio' name='perfil' value='inversionista' />
                <span class='pill-text'>{t('contact.form.profile3')}</span>
              </label>
              <label class='radio-pill'>
                <input type='radio' name='perfil' value='otro' />
                <span class='pill-text'>{t('contact.form.profile4')}</span>
              </label>
            </div>
          </div>

          <div class='form-group'>
            <label for='nombre' class='form-label'>{t('contact.form.name.label')}</label>
            <input type='text' id='nombre' name='nombre' class='form-input' placeholder={t('contact.form.name.placeholder')} required maxlength='100' />
          </div>

          <div class='form-group'>
            <label for='email' class='form-label'>{t('contact.form.email.label')}</label>
            <input type='email' id='email' name='email' class='form-input' placeholder={t('contact.form.email.placeholder')} required maxlength='150' />
          </div>

          <div class='form-group'>
            <label for='mensaje' class='form-label'>{t('contact.form.message.label')}</label>
            <textarea id='mensaje' name='mensaje' class='form-textarea' placeholder={t('contact.form.message.placeholder')} required maxlength='1500'></textarea>
          </div>

          <button type='submit' class='btn-submit'>{t('contact.form.submit')}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Autoselección de radio button por URL
    const urlParams = new URLSearchParams(window.location.search);
    const perfilDesdeURL = urlParams.get('perfil');

    if (perfilDesdeURL) {
      const radioButton = document.querySelector(`input[name="perfil"][value="${perfilDesdeURL}"]`) as HTMLInputElement;
      if (radioButton) radioButton.checked = true;
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // Animaciones del Hero
    const tlHero = gsap.timeline();
    gsap.set('.text-reveal', { autoAlpha: 0, y: 20 });
    tlHero
      .to('.hero-contacto__subtitle', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 })
      .to('.hero-contacto__title', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4')
      .to('.hero-contacto__description', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4');

    // Animación de la sección
    const contactSection = document.querySelector('.contacto-content');
    if (contactSection) {
      gsap.from('.trigger-reveal-contact', { scrollTrigger: { trigger: contactSection, start: 'top 85%' }, y: 40, autoAlpha: 0, duration: 0.8, stagger: 0.2, ease: 'power3.out' });
    }

    // Lógica del Formulario
    const contactForm = document.getElementById('agrovalue-contact-form') as HTMLFormElement;
    const submitBtn = contactForm?.querySelector('.btn-submit') as HTMLButtonElement;
    const timeField = document.getElementById('form_time') as HTMLInputElement;

    if (contactForm && timeField && submitBtn) {
      timeField.value = Date.now().toString();

      // Extraemos los mensajes traducidos de los data attributes
      const msgSending = contactForm.dataset.msgSending || 'Enviando...';
      const msgSuccess = contactForm.dataset.msgSuccess || '¡Enviado!';
      const msgError = contactForm.dataset.msgError || 'Error';

      contactForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const originalBtnText = submitBtn.innerText;
        submitBtn.innerText = msgSending;
        submitBtn.disabled = true;

        const formData = new FormData(contactForm);

        try {
          const response = await fetch('/enviar.php', { method: 'POST', body: formData });

          if (response.ok) {
            submitBtn.innerText = msgSuccess;
            submitBtn.style.backgroundColor = '#1a422a';
            contactForm.reset();
            timeField.value = Date.now().toString();
          } else {
            throw new Error('Fallo en el servidor o detectado como bot');
          }
        } catch (error) {
          console.error('Error:', error);
          submitBtn.innerText = msgError;
          submitBtn.style.backgroundColor = '#d32f2f';
        } finally {
          setTimeout(() => {
            submitBtn.innerText = originalBtnText;
            submitBtn.style.backgroundColor = '';
            submitBtn.disabled = false;
          }, 3500);
        }
      });
    }
  });
</script>