---
import { Image } from 'astro:assets';
import { useTranslations, getTranslatedRoute, type Lang } from '../i18n/utils';

import bannerMobile1 from '../assets/home/banner_Agrovalue_Mobile.webp';
import bannerMobile2 from '../assets/home/banner_Agrovalue_Mobile2.webp';
import bannerMobile3 from '../assets/home/banner_Agrovalue_Mobile3.webp';
import bannerMobile4 from '../assets/home/banner_Agrovalue_Mobile4.webp';
import bannerMobile5 from '../assets/home/banner_Agrovalue_Mobile5.webp';
import bannerMobile6 from '../assets/home/banner_Agrovalue_Mobile6.webp';
import bannerTablet1 from '../assets/home/banner_Agrovalue_Tablet.webp';
import bannerTablet2 from '../assets/home/banner_Agrovalue_Tablet2.webp';
import bannerTablet3 from '../assets/home/banner_Agrovalue_Tablet3.webp';
import bannerTablet4 from '../assets/home/banner_Agrovalue_Tablet4.webp';
import bannerTablet5 from '../assets/home/banner_Agrovalue_Tablet5.webp';
import bannerTablet6 from '../assets/home/banner_Agrovalue_Tablet6.webp';
import bannerDesktop1 from '../assets/home/banner_Agrovalue_Desktop.webp';
import bannerDesktop2 from '../assets/home/banner_Agrovalue_Desktop2.webp';
import bannerDesktop3 from '../assets/home/banner_Agrovalue_Desktop3.webp';
import bannerDesktop4 from '../assets/home/banner_Agrovalue_Desktop4.webp';
import bannerDesktop5 from '../assets/home/banner_Agrovalue_Desktop5.webp';
import bannerDesktop6 from '../assets/home/banner_Agrovalue_Desktop6.webp';

const lang = (Astro.currentLocale || 'es') as Lang;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const slideImages = [
  { mobile: bannerMobile1, tablet: bannerTablet1, desktop: bannerDesktop1 },
  { mobile: bannerMobile2, tablet: bannerTablet2, desktop: bannerDesktop2 },
  { mobile: bannerMobile3, tablet: bannerTablet3, desktop: bannerDesktop3 },
  { mobile: bannerMobile4, tablet: bannerTablet4, desktop: bannerDesktop4 },
  { mobile: bannerMobile5, tablet: bannerTablet5, desktop: bannerDesktop5 },
  { mobile: bannerMobile6, tablet: bannerTablet6, desktop: bannerDesktop6 },
];

// Generamos el título traduciendo y separando por palabras para la animación
const titleWords = t('home.title').split(' ');
---

<section id='section1' class='hero'>
  <div class='hero__slides-container'>
    {slideImages.map((slide, index) => (
      <div class={`hero__slide ${index === 0 ? 'is-active' : ''}`} data-index={index}>
        <div class='hero__background'>
          <Image src={slide.mobile} alt={`Fondo ${index + 1}`} class='hero__image hero__image--mobile' loading={index === 0 ? 'eager' : 'lazy'} />
          <Image src={slide.tablet} alt={`Fondo ${index + 1}`} class='hero__image hero__image--tablet' loading={index === 0 ? 'eager' : 'lazy'} />
          <Image src={slide.desktop} alt={`Fondo ${index + 1}`} class='hero__image hero__image--desktop' loading={index === 0 ? 'eager' : 'lazy'} />
          <div class='hero__overlay' />
          <div class='hero__overlay2' />
        </div>
      </div>
    ))}
  </div>

  <div class='hero__content'>
    <h1 class='hero__title'>
      {titleWords.map((word) => (
        <span class='word-wrap'><span class='word'>{word}</span>&nbsp;</span>
      ))}
    </h1>
    <p class='hero__description text-reveal'>{t('home.desc')}</p>
    <div class='hero__actions text-reveal'>
      <a href={getTranslatedRoute('/servicios', lang)} class='btn btn--primary'>
        {t('home.btn.services')}
      </a>
      <a href={getTranslatedRoute('/contacto', lang)} class='btn btn--outline'>
        {t('home.btn.contact')}
      </a>
    </div>
  </div>

  <div class='hero__progress'>
    <div class='hero__progress-bar' id='progress-bar'></div>
  </div>

  <div class='hero__minimal-footer'>
    <p>&copy; {currentYear} Agrovalue. {t('home.footer')}</p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero__slide');
    const dots = document.querySelectorAll('.dot');
    const progressBar = document.getElementById('progress-bar') as HTMLElement;
    const btnNext = document.getElementById('next-slide');
    const btnPrev = document.getElementById('prev-slide');

    let currentIndex = 0;
    let isAnimating = false;
    const totalSlides = slides.length;
    const slideDuration = 4;
    let timerTimeline: gsap.core.Tween | null = null;

    if (slides.length > 0) {
      gsap.set(slides, { autoAlpha: 0, zIndex: 1 });
      gsap.set(slides[0], { autoAlpha: 1, zIndex: 2 });

      const words = document.querySelectorAll('.hero__content .word');
      const reveals = document.querySelectorAll('.hero__content .text-reveal');

      const tlInit = gsap.timeline({ onComplete: initTimer });
      gsap.set(reveals, { autoAlpha: 0, y: 20 });
      gsap.set(words, { y: '100%' });

      tlInit
        .to(reveals[0], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 })
        .to(words, { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' }, '-=0.4')
        .to(reveals[1], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4')
        .to(reveals[2], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4');
    }

    function initTimer() {
      if (!progressBar) return;
      if (timerTimeline) timerTimeline.kill();
      timerTimeline = gsap.fromTo(
        progressBar,
        { scaleX: 0 },
        { scaleX: 1, duration: slideDuration, ease: 'none', transformOrigin: 'left center', onComplete: () => goToSlide(currentIndex + 1) }
      );
    }

    function goToSlide(index: number) {
      if (isAnimating) return;

      let nextIndex = index;
      if (nextIndex >= totalSlides) nextIndex = 0;
      if (nextIndex < 0) nextIndex = totalSlides - 1;
      if (nextIndex === currentIndex) return;

      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];

      gsap.set(nextSlide, { autoAlpha: 0, zIndex: 2 });
      gsap.set(currentSlide, { zIndex: 1 });

      gsap.to(nextSlide, {
        autoAlpha: 1,
        duration: 1.2,
        ease: 'power2.inOut',
        onComplete: () => {
          gsap.set(currentSlide, { autoAlpha: 0 });
          currentIndex = nextIndex;
          isAnimating = false;
          initTimer();
        },
      });

      dots.forEach((dot) => dot.classList.remove('dot--active'));
      if (dots[nextIndex]) dots[nextIndex].classList.add('dot--active');
    }

    btnNext?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex + 1);
    });

    btnPrev?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex - 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        if (timerTimeline) timerTimeline.kill();
        goToSlide(index);
      });
    });
  });
</script>