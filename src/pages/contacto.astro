---
/**
 * Página: Contacto
 * Descripción: Contiene la información de contacto de la empresa y el formulario
 * interactivo. Incluye medidas Anti-Spam (Honeypot y validación de tiempo).
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Mail, MapPin } from '@lucide/astro';

import imgContacto from '../assets/banner_Contacto_Desktop.jpg';
---

<Layout title='Agrovalue - Contacto'>
  <section class='hero-contacto'>
    <div class='hero-contacto__container'>
      <span class='hero-contacto__subtitle text-reveal'>CONTACTO</span>
      <h1 class='hero-contacto__title text-reveal'>
        <span class='word-wrap'>Conversemos sobre tu próximo desafío.</span>
      </h1>
      <p class='hero-contacto__description text-reveal'>
        Cuéntanos tu perfil y el servicio que necesitas. Dirigiremos tu consulta
        directamente con la persona indicada del equipo.
      </p>
    </div>
  </section>

  <section class='contacto-content'>
    <div class='contacto-content__container'>
      <div class='contacto-content__col-info trigger-reveal-contact'>
        <div class='contact-card contact-card--info'>
          <h2 class='contact-card__title'>Datos de contacto</h2>
          <p class='contact-card__desc'>
            Escríbenos y te pondremos en contacto con la persona indicada.
          </p>

          <ul class='contact-list'>
            <li>
              <a
                href='mailto:contacto@agrovalue.com'
                class='contact-list__icon'
                aria-label='Enviar correo'
              >
                <Mail
                  size={20}
                  stroke-width={2}
                />
              </a>
              <div class='contact-list__text'>
                <span class='label'>CORREO</span>
                <a
                  href='mailto:contacto@agrovalue.com'
                  class='value'
                  >contacto@agrovalue.com</a
                >
              </div>
            </li>
            <li>
              <a
                href='https://linkedin.com/company/agrovalue'
                target='_blank'
                rel='noopener noreferrer'
                class='contact-list__icon'
                aria-label='Visitar perfil de LinkedIn'
              >
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  width='20'
                  height='20'
                  viewBox='0 0 24 24'
                >
                  <path
                    d='M0 0h24v24H0z'
                    fill='none'
                  ></path>
                  <path
                    fill='currentColor'
                    d='M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z'
                  ></path>
                </svg>
              </a>
              <div class='contact-list__text'>
                <span class='label'>LINKEDIN</span>
                <a
                  href='https://linkedin.com/company/agrovalue'
                  target='_blank'
                  rel='noopener noreferrer'
                  class='value'
                  >/company/agrovalue</a
                >
              </div>
            </li>
            <!-- <li>
              <a
                href='https://www.google.com/maps/search/?api=1&query=Agrovalue'
                target='_blank'
                rel='noopener noreferrer'
                class='contact-list__icon'
                aria-label='Ver ubicación en el mapa'
              >
                <MapPin
                  size={20}
                  stroke-width={2}
                />
              </a>
              <div class='contact-list__text'>
                <span class='label'>COBERTURA</span>
                <a
                  href='https://www.google.com/maps/search/?api=1&query=Agrovalue'
                  target='_blank'
                  rel='noopener noreferrer'
                  class='value'
                  >Latinoamérica · EE. UU. · Asia</a
                >
              </div>
            </li> -->
          </ul>
        </div>

        <div class='contact-card contact-card--image'>
          <Image
            src={imgContacto}
            alt='Campo Agrovalue'
            class='contact-card__img'
          />
          <div class='contact-card__overlay'>
            <h3>Del campo al mundo, con un solo aliado.</h3>
          </div>
        </div>
      </div>

      <div class='contacto-content__col-form trigger-reveal-contact'>
        <div class='contact-card contact-card--form'>
          <form
            id='agrovalue-contact-form'
            class='contact-form'
          >
            <!-- Honeypot (Trampa para bots) - Oculto para humanos -->
            <div
              style='display:none; position:absolute; left:-9999px;'
              aria-hidden='true'
            >
              <label for='bot_field'>No llenes esto si eres humano</label>
              <input
                type='text'
                id='bot_field'
                name='bot_field'
                tabindex='-1'
                autocomplete='off'
              />
              <input
                type='hidden'
                id='form_time'
                name='form_time'
                value=''
              />
            </div>

            <div class='form-group'>
              <span class='form-label'>Soy:</span>
              <div class='radio-pill-group'>
                <label class='radio-pill'>
                  <input
                    type='radio'
                    name='perfil'
                    value='productor'
                    checked
                  />
                  <span class='pill-text'>Productor / exportador</span>
                </label>
                <label class='radio-pill'>
                  <input
                    type='radio'
                    name='perfil'
                    value='importador'
                  />
                  <span class='pill-text'>Importador / distribuidor</span>
                </label>
                <label class='radio-pill'>
                  <input
                    type='radio'
                    name='perfil'
                    value='inversionista'
                  />
                  <span class='pill-text'>Inversionista</span>
                </label>
                <label class='radio-pill'>
                  <input
                    type='radio'
                    name='perfil'
                    value='otro'
                  />
                  <span class='pill-text'>Otro</span>
                </label>
              </div>
            </div>

            <div class='form-group'>
              <label
                for='nombre'
                class='form-label'
                >Nombre</label
              >
              <input
                type='text'
                id='nombre'
                name='nombre'
                class='form-input'
                placeholder='Tu nombre'
                required
                maxlength='100'
              />
            </div>

            <div class='form-group'>
              <label
                for='email'
                class='form-label'
                >Email</label
              >
              <input
                type='email'
                id='email'
                name='email'
                class='form-input'
                placeholder='tu@correo.com'
                required
                maxlength='150'
              />
            </div>

            <div class='form-group'>
              <label
                for='mensaje'
                class='form-label'
                >Mensaje</label
              >
              <textarea
                id='mensaje'
                name='mensaje'
                class='form-textarea'
                placeholder='Cuéntanos brevemente tu necesidad...'
                required
                maxlength='1500'
              ></textarea>
            </div>

            <button
              type='submit'
              class='btn-submit'
              >Enviar consulta</button
            >
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const tlHero = gsap.timeline();
    gsap.set('.text-reveal', { autoAlpha: 0, y: 20 });
    tlHero
      .to('.hero-contacto__subtitle', {
        autoAlpha: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
        delay: 0.2,
      })
      .to(
        '.hero-contacto__title',
        { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' },
        '-=0.4',
      )
      .to(
        '.hero-contacto__description',
        { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' },
        '-=0.4',
      );

    const contactSection = document.querySelector('.contacto-content');
    if (contactSection) {
      gsap.from('.trigger-reveal-contact', {
        scrollTrigger: { trigger: contactSection, start: 'top 85%' },
        y: 40,
        autoAlpha: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: 'power3.out',
      });
    }

    const contactForm = document.getElementById(
      'agrovalue-contact-form',
    ) as HTMLFormElement;
    const submitBtn = contactForm?.querySelector(
      '.btn-submit',
    ) as HTMLButtonElement;
    const timeField = document.getElementById('form_time') as HTMLInputElement;

    if (contactForm && timeField) {
      // Registramos el momento exacto en el que el formulario es cargado
      timeField.value = Date.now().toString();

      contactForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const originalBtnText = submitBtn.innerText;
        submitBtn.innerText = 'Enviando...';
        submitBtn.disabled = true;

        const formData = new FormData(contactForm);
        const data = {
          perfil: formData.get('perfil'),
          nombre: formData.get('nombre'),
          email: formData.get('email'),
          mensaje: formData.get('mensaje'),
          bot_field: formData.get('bot_field'),
          form_time: formData.get('form_time'),
        };

        try {
          // const response = await fetch('/enviar.php', {
          //   method: 'POST',
          //   headers: { 'Content-Type': 'application/json' },
          //   body: JSON.stringify(data)
          // });
          await new Promise((resolve) => setTimeout(resolve, 2000));
          const response = { ok: true };

          if (response.ok) {
            submitBtn.innerText = '¡Mensaje Enviado!';
            submitBtn.style.backgroundColor = '#1a422a';
            contactForm.reset();
            // Reseteamos el contador para evitar bloqueos si envía un segundo mensaje
            timeField.value = Date.now().toString();
          } else {
            throw new Error('Fallo en el servidor o detectado como bot');
          }
        } catch (error) {
          console.error('Error:', error);
          submitBtn.innerText = 'Error al enviar';
          submitBtn.style.backgroundColor = '#d32f2f';
        } finally {
          setTimeout(() => {
            submitBtn.innerText = originalBtnText;
            submitBtn.style.backgroundColor = '';
            submitBtn.disabled = false;
          }, 3500);
        }
      });
    }
  });
</script>
