---
/**
 * Página: Inicio (Home)
 * Descripción: Landing page principal de Agrovalue.
 * Experiencia de pantalla completa (Full-screen) con Slider interactivo
 * de fondos y contenido estático sincronizado.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

import bannerMobile1 from '../assets/home/banner_Agrovalue_Mobile.png';
import bannerTablet1 from '../assets/home/banner_Agrovalue_Tablet.png';
import bannerDesktop1 from '../assets/home/banner_Agrovalue_Desktop.png';
import bannerMobile2 from '../assets/home/banner_Agrovalue_Mobile2.png';
import bannerTablet2 from '../assets/home/banner_Agrovalue_Tablet2.png';
import bannerDesktop2 from '../assets/home/banner_Agrovalue_Desktop2.png';
import bannerMobile3 from '../assets/home/banner_Agrovalue_Mobile3.png';
import bannerTablet3 from '../assets/home/banner_Agrovalue_Tablet3.png';
import bannerDesktop3 from '../assets/home/banner_Agrovalue_Desktop3.png';
import bannerMobile4 from '../assets/home/banner_Agrovalue_Mobile4.png';
import bannerTablet4 from '../assets/home/banner_Agrovalue_Tablet4.png';
import bannerDesktop4 from '../assets/home/banner_Agrovalue_Desktop4.png';
import bannerMobile5 from '../assets/home/banner_Agrovalue_Mobile5.png';
import bannerTablet5 from '../assets/home/banner_Agrovalue_Tablet5.png';
import bannerDesktop5 from '../assets/home/banner_Agrovalue_Desktop5.png';
import bannerMobile6 from '../assets/home/banner_Agrovalue_Mobile6.png';
import bannerTablet6 from '../assets/home/banner_Agrovalue_Tablet6.png';
import bannerDesktop6 from '../assets/home/banner_Agrovalue_Desktop6.png';

const currentYear = new Date().getFullYear();

// 1. ARRAY EXCLUSIVO DE IMÁGENES
const slideImages = [
  {
    mobile: bannerMobile1,
    tablet: bannerTablet1,
    desktop: bannerDesktop1,
  },
  {
    mobile: bannerMobile2,
    tablet: bannerTablet2,
    desktop: bannerDesktop2,
  },
  {
    mobile: bannerMobile3,
    tablet: bannerTablet3,
    desktop: bannerDesktop3,
  },
  {
    mobile: bannerMobile4,
    tablet: bannerTablet4,
    desktop: bannerDesktop4,
  },
  {
    mobile: bannerMobile5,
    tablet: bannerTablet5,
    desktop: bannerDesktop5,
  },
  {
    mobile: bannerMobile6,
    tablet: bannerTablet6,
    desktop: bannerDesktop6,
  }
];

// Texto fijo para el Hero
const heroTitle = 'Conectamos el campo con el mundo, generando valor para cada productor.';
---

<Layout
  title='Agrovalue - Inicio'
  hideFooter={true}
>
  <section id='section1' class='hero'>
    
    <!-- CONTENEDOR DE FONDOS (Solo cambian las imágenes) -->
    <div class='hero__slides-container'>
      {
        slideImages.map((slide, index) => (
          <div
            class={`hero__slide ${index === 0 ? 'is-active' : ''}`}
            data-index={index}
          >
            <div class='hero__background'>
              <Image
                src={slide.mobile}
                alt={`Fondo ${index + 1}`}
                class='hero__image hero__image--mobile'
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <Image
                src={slide.tablet}
                alt={`Fondo ${index + 1}`}
                class='hero__image hero__image--tablet'
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <Image
                src={slide.desktop}
                alt={`Fondo ${index + 1}`}
                class='hero__image hero__image--desktop'
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <div class='hero__overlay' />
              <div class='hero__overlay2' />
            </div>
          </div>
        ))
      }
    </div>

    <!-- CONTENIDO ESTÁTICO FIJO EN EL HTML -->
    <div class='hero__content'>
      <span class='hero__subtitle text-reveal'>AGROVALUE</span>
      <h1 class='hero__title'>
        {heroTitle.split(' ').map((word) => (
          <span class='word-wrap'>
            <span class='word'>{word}</span>&nbsp;
          </span>
        ))}
      </h1>
      <p class='hero__description text-reveal'>
        Integramos mercados, capital y tecnología para que productores, compradores e inversionistas crezcan con confianza.
      </p>
      <div class='hero__actions text-reveal'>
        <a href='/servicios' class='btn btn--primary'>
          Conoce nuestros servicios
        </a>
        <a href='/contacto' class='btn btn--outline'>
          Contáctanos
        </a>
      </div>
    </div>

    <!-- CONTROLES Y NAVEGACIÓN -->
    <div class='hero__ui'>
      <div class='hero__controls'>
        <div class='slider-arrows'>
          <button class='arrow-btn arrow-btn--outline' id='prev-slide' aria-label='Diapositiva anterior'>
            <ChevronLeft size={20} />
          </button>
          <button class='arrow-btn arrow-btn--solid' id='next-slide' aria-label='Siguiente diapositiva'>
            <ChevronRight size={20} />
          </button>
        </div>
        <div class='slider-pagination'>
          {
            slideImages.map((_, index) => (
              <span class={`dot ${index === 0 ? 'dot--active' : ''}`} data-index={index} />
            ))
          }
        </div>
      </div>
    </div>

    <div class='hero__progress'>
      <div class='hero__progress-bar' id='progress-bar'></div>
    </div>

    <!-- MINI FOOTER PARA EL HOME -->
    <div class='hero__minimal-footer'>
      <p>&copy; {currentYear} Agrovalue. Todos los derechos reservados.</p>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero__slide');
    const dots = document.querySelectorAll('.dot');
    const progressBar = document.getElementById('progress-bar') as HTMLElement;
    const btnNext = document.getElementById('next-slide');
    const btnPrev = document.getElementById('prev-slide');

    let currentIndex = 0;
    let isAnimating = false;
    const totalSlides = slides.length;
    const slideDuration = 10;
    let timerTimeline: gsap.core.Tween | null = null;

    if (slides.length > 0) {
      // 1. Configuramos las capas de fondo
      gsap.set(slides, { autoAlpha: 0, zIndex: 1 });
      gsap.set(slides[0], { autoAlpha: 1, zIndex: 2 });

      // 2. Animación de entrada inicial del texto (Ocurre UNA vez al cargar la página)
      const words = document.querySelectorAll('.hero__content .word');
      const reveals = document.querySelectorAll('.hero__content .text-reveal');
      
      const tlInit = gsap.timeline({ onComplete: initTimer });
      gsap.set(reveals, { autoAlpha: 0, y: 20 });
      gsap.set(words, { y: '100%' });

      tlInit.to(reveals[0], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 })
            .to(words, { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' }, '-=0.4')
            .to(reveals[1], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4')
            .to(reveals[2], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4');
    }

    function initTimer() {
      if (!progressBar) return;
      if (timerTimeline) timerTimeline.kill();
      timerTimeline = gsap.fromTo(
        progressBar,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: slideDuration,
          ease: 'none',
          transformOrigin: 'left center',
          onComplete: () => goToSlide(currentIndex + 1),
        },
      );
    }

    function goToSlide(index: number) {
      if (isAnimating) return;

      let nextIndex = index;
      if (nextIndex >= totalSlides) nextIndex = 0;
      if (nextIndex < 0) nextIndex = totalSlides - 1;
      if (nextIndex === currentIndex) return;

      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];

      // Preparamos la siguiente imagen para estar por encima y oculta
      gsap.set(nextSlide, { autoAlpha: 0, zIndex: 2 });
      gsap.set(currentSlide, { zIndex: 1 });

      // 1. Crossfade suave de la imagen de fondo (1.2 segundos)
      gsap.to(nextSlide, {
        autoAlpha: 1,
        duration: 1.2, 
        ease: 'power2.inOut',
        onComplete: () => {
          gsap.set(currentSlide, { autoAlpha: 0 }); // Ocultamos la anterior
          currentIndex = nextIndex;
          isAnimating = false;
          initTimer();
        }
      });

      // 2. Animación sutil y sincronizada del texto estático
      // El texto baja y pierde un poco de opacidad, luego vuelve a subir a su lugar
      const tlText = gsap.timeline();
      tlText.to('.hero__content', { 
              y: 15, 
              opacity: 0.6, 
              duration: 0.5, 
              ease: 'power2.out' 
            })
            .to('.hero__content', { 
              y: 0, 
              opacity: 1, 
              duration: 0.7, 
              ease: 'power2.out' 
            });

      // Actualizamos los dots de paginación
      dots.forEach((dot) => dot.classList.remove('dot--active'));
      dots[nextIndex].classList.add('dot--active');
    }

    btnNext?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex + 1);
    });

    btnPrev?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex - 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        if (timerTimeline) timerTimeline.kill();
        goToSlide(index);
      });
    });
  });
</script>