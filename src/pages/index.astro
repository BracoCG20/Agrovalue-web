---
/**
 * Página: Inicio (Home)
 * Descripción: Landing page principal de Agrovalue.
 * Experiencia de pantalla completa (Full-screen) con Slider interactivo
 * y un pie de página minimalista.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

import bannerMobile from '../assets/banner_Agrovalue_Mobile.jpg';
import bannerTablet from '../assets/banner_Agrovalue_Tablet.jpg';
import bannerDesktop from '../assets/banner_Agrovalue_Desktop.jpg';

const currentYear = new Date().getFullYear();

const sliderData = [
  {
    subtitle: 'AGROVALUE',
    title: 'Conectamos el campo con el mundo para generar valor en toda la cadena agroexportadora.',
    description: 'Integramos mercados, capital y tecnología para que productores, compradores e inversionistas crezcan con confianza.',
    imageMobile: bannerMobile,
    imageTablet: bannerTablet,
    imageDesktop: bannerDesktop,
  },
  {
    subtitle: 'INNOVACIÓN',
    title: 'Tecnología agrícola de vanguardia para potenciar tus cultivos y maximizar rendimientos.',
    description: 'Desarrollamos soluciones integrales adaptadas a las necesidades específicas de cada mercado internacional.',
    imageMobile: bannerMobile,
    imageTablet: bannerTablet,
    imageDesktop: bannerDesktop,
  },
  {
    subtitle: 'SOSTENIBILIDAD',
    title: 'Crecimiento sostenible y confiable para el futuro del ecosistema agroexportador.',
    description: 'Acompañamos a productores en su transición hacia prácticas más rentables y amigables con el medio ambiente.',
    imageMobile: bannerMobile,
    imageTablet: bannerTablet,
    imageDesktop: bannerDesktop,
  },
];
---

<Layout title="Agrovalue - Inicio" hideFooter={true}>
  <!-- HERO SLIDER FULL SCREEN -->
  <section id="section1" class="hero">
    <div class="hero__slides-container">
      {sliderData.map((slide, index) => (
        <div class={`hero__slide ${index === 0 ? 'is-active' : ''}`} data-index={index}>
          <div class="hero__background">
            <Image src={slide.imageMobile} alt={`Slide ${index + 1}`} class="hero__image hero__image--mobile" loading={index === 0 ? 'eager' : 'lazy'} />
            <Image src={slide.imageTablet} alt={`Slide ${index + 1}`} class="hero__image hero__image--tablet" loading={index === 0 ? 'eager' : 'lazy'} />
            <Image src={slide.imageDesktop} alt={`Slide ${index + 1}`} class="hero__image hero__image--desktop" loading={index === 0 ? 'eager' : 'lazy'} />
            <div class="hero__overlay" />
            <div class="hero__overlay2" />
          </div>

          <div class="hero__content">
            <span class="hero__subtitle text-reveal">{slide.subtitle}</span>
            <h1 class="hero__title">
              {slide.title.split(' ').map((word) => (
                <span class="word-wrap">
                  <span class="word">{word}</span>&nbsp;
                </span>
              ))}
            </h1>
            <p class="hero__description text-reveal">{slide.description}</p>
            <div class="hero__actions text-reveal">
              <a href="/servicios" class="btn btn--primary">
                Conoce nuestros servicios
              </a>
              <a href="/contacto" class="btn btn--outline">
                Contáctanos
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="hero__ui">
      <div class="hero__controls">
        <div class="slider-arrows">
          <button class="arrow-btn arrow-btn--outline" id="prev-slide" aria-label="Diapositiva anterior">
            <ChevronLeft size={20} />
          </button>
          <button class="arrow-btn arrow-btn--solid" id="next-slide" aria-label="Siguiente diapositiva">
            <ChevronRight size={20} />
          </button>
        </div>
        <div class="slider-pagination">
          {sliderData.map((_, index) => (
            <span class={`dot ${index === 0 ? 'dot--active' : ''}`} data-index={index} />
          ))}
        </div>
      </div>
    </div>

    <div class="hero__progress">
      <div class="hero__progress-bar" id="progress-bar"></div>
    </div>

    <!-- MINI FOOTER PARA EL HOME -->
    <div class="hero__minimal-footer">
      <p>&copy; {currentYear} Agrovalue. Todos los derechos reservados.</p>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    /**
     * Lógica del Slider Automático (Hero)
     */
    const slides = document.querySelectorAll('.hero__slide');
    const dots = document.querySelectorAll('.dot');
    const progressBar = document.getElementById('progress-bar') as HTMLElement;
    const btnNext = document.getElementById('next-slide');
    const btnPrev = document.getElementById('prev-slide');

    let currentIndex = 0;
    let isAnimating = false;
    const totalSlides = slides.length;
    const slideDuration = 10;
    let timerTimeline: gsap.core.Tween | null = null;

    if (slides.length > 0) {
      gsap.set(slides, { autoAlpha: 0, zIndex: 1 });
      gsap.set(slides[0], { autoAlpha: 1, zIndex: 2 });

      const firstWords = slides[0].querySelectorAll('.word');
      const firstReveal = slides[0].querySelectorAll('.text-reveal');
      gsap.set([firstWords, firstReveal], { y: 0, autoAlpha: 1 });

      initTimer();
    }

    function initTimer() {
      if (!progressBar) return;
      if (timerTimeline) timerTimeline.kill();
      timerTimeline = gsap.fromTo(
        progressBar,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: slideDuration,
          ease: 'none',
          transformOrigin: 'left center',
          onComplete: () => goToSlide(currentIndex + 1),
        },
      );
    }

    function goToSlide(index: number) {
      if (isAnimating) return;

      let nextIndex = index;
      if (nextIndex >= totalSlides) nextIndex = 0;
      if (nextIndex < 0) nextIndex = totalSlides - 1;
      if (nextIndex === currentIndex) return;

      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];
      const nextWords = nextSlide.querySelectorAll('.word');
      const nextReveal = nextSlide.querySelectorAll('.text-reveal');

      gsap.set(nextSlide, { autoAlpha: 0, zIndex: 2 });
      gsap.set(currentSlide, { zIndex: 1 });
      gsap.set(nextWords, { y: '100%' });
      gsap.set(nextReveal, { y: 20, autoAlpha: 0 });

      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set(currentSlide, { autoAlpha: 0 });
          currentIndex = nextIndex;
          isAnimating = false;
          initTimer();
        },
      });

      tl.to(nextSlide, { autoAlpha: 1, duration: 1, ease: 'power2.inOut' })
        .to(nextReveal[0], { y: 0, autoAlpha: 1, duration: 0.6, ease: 'power3.out' }, '-=0.3')
        .to(nextWords, { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' }, '-=0.4')
        .to(nextReveal[1], { y: 0, autoAlpha: 1, duration: 0.6, ease: 'power3.out' }, '-=0.4')
        .to(nextReveal[2], { y: 0, autoAlpha: 1, duration: 0.6, ease: 'power3.out' }, '-=0.4');

      dots.forEach((dot) => dot.classList.remove('dot--active'));
      dots[nextIndex].classList.add('dot--active');
    }

    btnNext?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex + 1);
    });

    btnPrev?.addEventListener('click', () => {
      if (timerTimeline) timerTimeline.kill();
      goToSlide(currentIndex - 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        if (timerTimeline) timerTimeline.kill();
        goToSlide(index);
      });
    });
  });
</script>