---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';

import { perfilesData } from '../data/serviciosData.js';

import bannerDesktop from '../assets/banner_Service_Desktop.jpg';
import bannerTablet from '../assets/banner_Service_Desktop.jpg';
import bannerMobile from '../assets/banner_Service_Desktop.jpg';
import logoBlanco from '../assets/Logo_Agrovalue_blanco.svg';

const titleText =
  'Cada actor de la cadena tiene un reto distinto. Nosotros tenemos una respuesta para cada uno.';
---

<Layout title='Agrovalue - Servicios'>
  <section class='hero-servicios'>
    <div class='hero-servicios__background'>
      <Image
        src={bannerMobile}
        alt='Fondo Servicios Mobile'
        class='hero-servicios__image hero-servicios__image--mobile'
        loading='eager'
      />
      <Image
        src={bannerTablet}
        alt='Fondo Servicios Tablet'
        class='hero-servicios__image hero-servicios__image--tablet'
        loading='eager'
      />
      <Image
        src={bannerDesktop}
        alt='Fondo Servicios Desktop'
        class='hero-servicios__image hero-servicios__image--desktop'
        loading='eager'
      />
      <div class='hero-servicios__overlay'></div>
    </div>

    <div class='hero-servicios__content'>
      <span class='hero-servicios__subtitle text-reveal'>SERVICIOS</span>
      <h1 class='hero-servicios__title'>
        {
          titleText.split(' ').map((word) => (
            <span class='word-wrap'>
              <span class='word'>{word}</span>&nbsp;
            </span>
          ))
        }
      </h1>

      <div class='hero-servicios__actions text-reveal'>
        <!-- ✨ Enlaces actualizados para llevar los parámetros de URL -->
        <a
          href='#productor-exportador'
          class='btn-profile'
        >
          <span>Productor / Exportador</span>
          <ArrowRight size={20} />
        </a>
        <a
          href='#importador-distribuidor'
          class='btn-profile'
        >
          <span>Importador / Distribuidor</span>
          <ArrowRight size={20} />
        </a>
        <a
          href='#proyectos-especiales'
          class='btn-profile'
        >
          <span>Proyectos especiales</span>
          <ArrowRight size={20} />
        </a>
      </div>
    </div>
  </section>

  <section class='perfiles-wrapper'>
    {
      perfilesData.map((perfil) => (
        <section
          class='perfil-detail'
          id={perfil.id}
        >
          <div class='pd-intro'>
            <div class='pd-intro-content'>
              <div class='pd-intro-content-container1'>
                <span class='pd-intro-content-container1__number'>
                  {perfil.number}
                </span>
              </div>
              <div class='pd-intro-content-container2'>
                <span class='pd-intro-content-container2__subtitle'>
                  {perfil.subtitle}
                </span>
                <h2 class='pd-intro-content-container2__title'>
                  {perfil.title}
                </h2>
                <p class='pd-intro-content-container2__text'>{perfil.text}</p>
              </div>
            </div>
          </div>

          <div class='pd-comparison'>
            <div class='pd-comparison-container'>
              <div class='pd-comparison-container__box pd-comparison-container__box--dark'>
                <span class='pd-comparison-container__subtitle'>
                  {perfil.problem.subtitle}
                </span>
                <h3 class='pd-comparison-container__title'>
                  {perfil.problem.title}
                </h3>
                <p class='pd-comparison-container__text'>
                  {perfil.problem.text}
                </p>
              </div>

              <div class='pd-comparison-container__box pd-comparison-container__box--light'>
                <span class='pd-comparison-container__subtitle'>
                  {perfil.solution.subtitle}
                </span>
                <h3 class='pd-comparison-container__title'>
                  {perfil.solution.title}
                </h3>
                <p class='pd-comparison-container__text'>
                  {perfil.solution.text}
                </p>
              </div>

              <div class='pd-comparison-container__icon'>
                <Image
                  src={logoBlanco}
                  alt='Logo Agrovalue'
                  width={24}
                  height={24}
                />
              </div>
            </div>
          </div>

          <div class='pd-image'>
            <Image
              src={perfil.image}
              alt={perfil.imageAlt}
              class='pd-image__img'
            />
          </div>

          {perfil.services.length > 0 && (
            <div class='pd-services'>
              <div class='pd-content'>
                <span class='pd-section-subtitle'>QUÉ HACEMOS POR TI</span>
                <div class='pd-list'>
                  {perfil.services.map((service) => (
                    <div class='pd-list__item'>
                      <span class='pd-list__num'>{service.num}</span>
                      <div class='pd-list__content'>
                        <h4>{service.title}</h4>
                        <p>{service.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {perfil.processes.length > 0 && (
            <div class='pd-process'>
              <div class='pd-content'>
                <span class='pd-section-subtitle'>CÓMO TRABAJAMOS</span>
                <div class='pd-process-list'>
                  {perfil.processes.map((process) => (
                    <div class='pd-process-list__item'>
                      <div class='pd-process-list-content1'>
                        <div class='pd-process-list-content1__circle'>
                          {process.num}
                        </div>
                        <div class='pd-process-list-content1__line' />
                      </div>
                      <div class='pd-process-list-content2'>
                        <h4>{process.title}</h4>
                        <p>{process.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          <div class='pd-cta'>
            <div class='pd-content'>
              <div class='pd-cta-container'>
                <h3 class='pd-cta-container__title'>{perfil.cta.title}</h3>
                <p class='pd-cta-container__text'>{perfil.cta.text}</p>
              </div>
              <a
                href={perfil.cta.btnLink}
                class='pd-cta__btn'
              >
                {perfil.cta.btnText} <ArrowRight size={18} />
              </a>
            </div>
          </div>
        </section>
      ))
    }
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Animación del Hero
    const tlHero = gsap.timeline();
    gsap.set('.hero-servicios__subtitle', { autoAlpha: 0, y: 20 });
    gsap.set('.hero-servicios .word', { y: '100%' });
    gsap.set('.hero-servicios__actions', { autoAlpha: 0, y: 20 });

    tlHero
      .to('.hero-servicios__subtitle', {
        autoAlpha: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
        delay: 0.3,
      })
      .to(
        '.hero-servicios .word',
        { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' },
        '-=0.4',
      )
      .to(
        '.hero-servicios__actions',
        { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' },
        '-=0.2',
      );

    // ✨ Animaciones al hacer Scroll en cada perfil
    const perfiles = document.querySelectorAll('.perfil-detail');

    perfiles.forEach((perfil) => {
      const introElements = perfil.querySelectorAll(
        '.pd-intro-content-container1__number, .pd-intro-content-container2 > *',
      );
      gsap.from(introElements, {
        scrollTrigger: {
          trigger: perfil.querySelector('.pd-intro'),
          start: 'top 85%',
        },
        y: 40,
        autoAlpha: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power3.out',
      });

      const compBoxes = perfil.querySelectorAll(
        '.pd-comparison-container__box',
      );
      const compIcon = perfil.querySelector('.pd-comparison-container__icon');

      const tlComp = gsap.timeline({
        scrollTrigger: {
          trigger: perfil.querySelector('.pd-comparison'),
          start: 'top 80%',
        },
      });

      tlComp
        .from(compBoxes, {
          y: 50,
          autoAlpha: 0,
          duration: 0.8,
          stagger: 0.2,
          ease: 'power3.out',
        })
        .from(
          compIcon,
          { scale: 0, autoAlpha: 0, duration: 0.6, ease: 'back.out(1.5)' },
          '-=0.4',
        );

      const image = perfil.querySelector('.pd-image__img');
      gsap.from(image, {
        scrollTrigger: {
          trigger: perfil.querySelector('.pd-image'),
          start: 'top 85%',
        },
        y: 30,
        autoAlpha: 0,
        scale: 0.97,
        duration: 1,
        ease: 'power3.out',
      });

      const servicesSection = perfil.querySelector('.pd-services');
      if (servicesSection) {
        const servicesItems = servicesSection.querySelectorAll(
          '.pd-section-subtitle, .pd-list__item',
        );
        gsap.from(servicesItems, {
          scrollTrigger: { trigger: servicesSection, start: 'top 85%' },
          y: 30,
          autoAlpha: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power3.out',
        });
      }

      const processSection = perfil.querySelector('.pd-process');
      if (processSection) {
        const processItems = processSection.querySelectorAll(
          '.pd-section-subtitle, .pd-process-list__item',
        );
        gsap.from(processItems, {
          scrollTrigger: { trigger: processSection, start: 'top 85%' },
          y: 30,
          autoAlpha: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power3.out',
        });
      }

      const ctaSection = perfil.querySelector('.pd-cta');
      if (ctaSection) {
        const ctaElements = ctaSection.querySelectorAll(
          '.pd-cta-container__title, .pd-cta-container__text',
        );
        gsap.from(ctaElements, {
          scrollTrigger: { trigger: ctaSection, start: 'top 85%' },
          y: 30,
          autoAlpha: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power3.out',
        });
      }
    });
  });
</script>
