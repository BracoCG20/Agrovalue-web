---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';

// Imágenes del Hero
import bannerDesktop from '../assets/banner_Service_Desktop.jpg';
import bannerTablet from '../assets/banner_Service_Desktop.jpg';
import bannerMobile from '../assets/banner_Service_Mobile.jpg';

// Imágenes de la nueva sección (Asegúrate de tenerlas en la carpeta assets)
import imgServicios1 from '../assets/banner_Agrovalue_servicios.jpg';
import logoBlanco from '../assets/Logo_Agrovalue_blanco.svg';

const titleText = 'Cada actor de la cadena tiene un reto distinto. Nosotros tenemos una respuesta para cada uno.';
---

<Layout title='Agrovalue - Servicios'>
  <!-- HERO -->
  <section class='hero-servicios'>
    <div class='hero-servicios__background'>
      <Image src={bannerMobile} alt='Fondo Servicios Mobile' class='hero-servicios__image hero-servicios__image--mobile' loading='eager' />
      <Image src={bannerTablet} alt='Fondo Servicios Tablet' class='hero-servicios__image hero-servicios__image--tablet' loading='eager' />
      <Image src={bannerDesktop} alt='Fondo Servicios Desktop' class='hero-servicios__image hero-servicios__image--desktop' loading='eager' />
      <div class='hero-servicios__overlay'></div>
    </div>

    <div class='hero-servicios__content'>
      <span class='hero-servicios__subtitle text-reveal'>SERVICIOS</span>
      <h1 class='hero-servicios__title'>
        {titleText.split(' ').map((word) => (
          <span class='word-wrap'><span class='word'>{word}</span>&nbsp;</span>
        ))}
      </h1>

      <div class='hero-servicios__actions text-reveal'>
        <a href='#productor-exportador' class='btn-profile'>
          <span>Productor / Exportador</span>
          <ArrowRight size={20} stroke-width={2} />
        </a>
        <a href='#importador-distribuidor' class='btn-profile'>
          <span>Importador / Distribuidor</span>
          <ArrowRight size={20} stroke-width={2} />
        </a>
        <a href='#proyectos-especiales' class='btn-profile'>
          <span>Proyectos especiales</span>
          <ArrowRight size={20} stroke-width={2} />
        </a>
      </div>
    </div>
  </section>

  <!-- DETALLE PERFILES -->
  <div class="perfiles-wrapper">
    
    <!-- SECCIÓN 01: PRODUCTOR / EXPORTADOR -->
    <section class="perfil-detail" id="productor-exportador">
      <div class="perfil-detail__container">
        
        <!-- 1. Intro -->
        <div class="pd-intro">
          <span class="pd-intro__number">01</span>
          <span class="pd-intro__subtitle">PRODUCTOR / EXPORTADOR</span>
          <h2 class="pd-intro__title">Tu fruta puede llegar más lejos de lo que crees.</h2>
          <p class="pd-intro__text">Te conectamos con mercados, financiamiento y tecnología para que cada campaña capture su verdadero valor.</p>
        </div>

        <!-- 2. Problema / Solución -->
        <div class="pd-comparison">
          <div class="pd-comparison__box pd-comparison__box--dark">
            <span class="pd-comparison__subtitle">— EL PROBLEMA</span>
            <h3 class="pd-comparison__title">Tu fruta no debería perder valor después de salir del campo.</h3>
            <p class="pd-comparison__text">Sin el comprador correcto, el financiamiento a tiempo o visibilidad del camino, ese valor se queda en manos de intermediarios o en oportunidades que nunca llegaron a ti.</p>
          </div>

          <div class="pd-comparison__box pd-comparison__box--light">
            <span class="pd-comparison__subtitle">— POR QUÉ AGROVALUE</span>
            <h3 class="pd-comparison__title">No necesitas manejar todo por tu cuenta. Necesitas un socio que lo resuelva todo.</h3>
            <p class="pd-comparison__text">Integramos mercado, financiamiento y tecnología en un solo socio, para que captures más valor en cada programa de exportación, cumpliendo con la calidad, el volumen y la oportunidad que exigen los principales compradores.</p>
          </div>
           <!-- Círculo que sobrepone ambas cajas -->
          <div class="pd-comparison__icon">
            <Image src={logoBlanco} alt="Logo Agrovalue" width={24} height={24} />
            </div>
        </div>

        <!-- 3. Imagen -->
        <div class="pd-image">
          <Image src={imgServicios1} alt="Productora mostrando racimo de uvas verdes" class="pd-image__img" />
        </div>

        <!-- 4. Qué hacemos por ti -->
        <div class="pd-services">
          <span class="pd-section-subtitle">QUÉ HACEMOS POR TI</span>
          <ul class="pd-list">
            <li class="pd-list__item">
              <span class="pd-list__num">01</span>
              <div class="pd-list__content">
                <h4>Compradores que sí van a pagar lo que vale tu fruta.</h4>
                <p>Te conectamos con compradores confiables en los principales mercados internacionales, desarrollando programas comerciales sostenibles y relaciones de largo plazo.</p>
              </div>
            </li>
            <li class="pd-list__item">
              <span class="pd-list__num">02</span>
              <div class="pd-list__content">
                <h4>El capital que necesitas, cuando lo necesitas.</h4>
                <p>Facilitamos soluciones de financiamiento que fortalecen tu capital de trabajo y te permiten desarrollar tus programas de exportación con mayor solidez.</p>
              </div>
            </li>
            <li class="pd-list__item">
              <span class="pd-list__num">03</span>
              <div class="pd-list__content">
                <h4>Tu fruta, respaldada desde el campo hasta el destino.</h4>
                <p>Gestión de calidad de principio a fin: verificamos las especificaciones del cliente, la normativa vigente y los estándares internacionales de inocuidad.</p>
              </div>
            </li>
            <li class="pd-list__item">
              <span class="pd-list__num">04</span>
              <div class="pd-list__content">
                <h4>Control de calidad que anticipa.</h4>
                <p>Inspecciones independientes en línea de producción y en destino, monitoreando las certificaciones que exige cada mercado.</p>
              </div>
            </li>
            <li class="pd-list__item">
              <span class="pd-list__num">05</span>
              <div class="pd-list__content">
                <h4>Un aliado que también piensa en tu próxima campaña.</h4>
                <p>Te asesoramos en tecnologías y procesos que mejoran tu productividad, calidad y competitividad campaña tras campaña.</p>
              </div>
            </li>
            <li class="pd-list__item">
              <span class="pd-list__num">06</span>
              <div class="pd-list__content">
                <h4>Tecnología detrás de cada buena decisión.</h4>
                <p>Centralizamos cada programa de exportación en un solo lugar, con trazabilidad y visibilidad en tiempo real desde el campo hasta el destino.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- 5. Cómo trabajamos -->
        <div class="pd-process">
          <span class="pd-section-subtitle">CÓMO TRABAJAMOS</span>
          <ul class="pd-process-list">
            <li class="pd-process-list__item">
              <div class="pd-process-list__circle">1</div>
              <div class="pd-process-list__content">
                <h4>Conocemos tu campo.</h4>
                <p>Evaluamos tu producción, variedad, volumen y capacidad exportable.</p>
              </div>
            </li>
            <li class="pd-process-list__item">
              <div class="pd-process-list__circle">2</div>
              <div class="pd-process-list__content">
                <h4>Te conectamos con el mercado correcto.</h4>
                <p>Activamos nuestra red de compradores según tu producto y ventana comercial.</p>
              </div>
            </li>
            <li class="pd-process-list__item">
              <div class="pd-process-list__circle">3</div>
              <div class="pd-process-list__content">
                <h4>Acompañamos cada embarque.</h4>
                <p>Control de calidad, documentación y seguimiento en tiempo real con tecnología propia.</p>
              </div>
            </li>
            <li class="pd-process-list__item">
              <div class="pd-process-list__circle">4</div>
              <div class="pd-process-list__content">
                <h4>Cerramos el ciclo contigo.</h4>
                <p>Liquidación transparente y aprendizajes para la siguiente campaña.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- 6. CTA -->
        <div class="pd-cta">
          <h3 class="pd-cta__title">Lleva tu próxima campaña más lejos.</h3>
          <p class="pd-cta__text">Cuéntanos qué produces, cuánto y cuándo, y te mostramos las oportunidades comerciales y de financiamiento disponibles para ti.</p>
          <a href="/contacto" class="pd-cta__btn">Contáctanos <ArrowRight size={18} stroke-width={2.5}/></a>
        </div>

      </div>
    </section>

    <!-- (Aquí en el futuro puedes duplicar el bloque de arriba para la sección 02 y 03) -->

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Scroll Suave para los botones del Hero
    document.querySelectorAll('.btn-profile').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const href = this.getAttribute('href');
        if(href && href.startsWith('#')) {
          e.preventDefault();
          const target = document.querySelector(href);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    const tlHero = gsap.timeline();
    gsap.set('.hero-servicios__subtitle', { autoAlpha: 0, y: 20 });
    gsap.set('.hero-servicios .word', { y: '100%' });
    gsap.set('.hero-servicios__actions', { autoAlpha: 0, y: 20 });

    tlHero
      .to('.hero-servicios__subtitle', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.3 })
      .to('.hero-servicios .word', { y: '0%', duration: 0.6, stagger: 0.03, ease: 'power3.out' }, '-=0.4')
      .to('.hero-servicios__actions', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.2');
  });
</script>